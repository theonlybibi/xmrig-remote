[Unit]
Description=Xmrig remote control API
After=network-online.target
Wants=network-online.target

[Service]
User=xmrig-api
Group=xmrig-api
EnvironmentFile=@ENV_FILE@
ExecStart=/usr/bin/python3 /opt/xmrig-api/xmrig_api.py
Restart=on-failure
RestartSec=3

# Private state (config.json backup); owned by xmrig-api, mode 0700
StateDirectory=xmrig-api
StateDirectoryMode=0700
# The ONLY place outside the state dir the sandbox lets this service write to.
# File permissions (an ACL on config.json alone) still decide what it may modify.
ReadWritePaths=-@CONFIG_DIR@

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
